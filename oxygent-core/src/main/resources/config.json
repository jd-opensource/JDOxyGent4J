{
    "default": {
        "app": {
            "name": "app",
            "version": "1.0.0",
            "biz_type": "oxygent",
            "scan_oxygent_path": "com.jd"
        },
        "llm": {
            "temperature": 0.1,
            "max_tokens": 4096,
            "top_p": 1,
            "semaphore": 16,
            "timeout": 300
        },
        "xfile": {
          "save_dir": "./cache_dir/xfile"
        },
        "message": {
            "send_tool_call": true,
            "detailed_tool_call": true,
            "send_observation": true,
            "detailed_observation": true,
            "send_think": true,
            "send_answer": true,
            "stored": true,
            "stream_batch_size": 256,
            "show_in_terminal": true,
            "send_full_arguments": false
        },
        "vearch": {},
        "es": {
          "type": "local",
          "hosts": [
            "${ES_HOST_1}",
            "${ES_HOST_2}",
            "${ES_HOST_3}"
          ],
          "user": "${ES_TEST_USER}",
          "password": "${ES_TEST_PASSWORD}",
          "number_of_shards": 2,
          "number_of_replicas": 1
        },
        "redis": {
          "host": "127.0.0.1",
          "port": 6379,
          "database": 0,
          "password": "RedisOxyGentTeam",
          "timeout": 5000
        },
        "server": {
            "host": "127.0.0.1",
            "port": 8080,
            "auto_open_webpage": true,
            "log_level": "INFO",
            "workers": 1
        },
        "oxy": {
            "semaphore": 1024,
            "timeout": 3600,
            "retries": 2,
            "delay": 1.0
        },
        "agent": {
            "prompt": "",
            "llm_model": "default_llm",
            "input_schema": {
                "properties": {"query": {"description": "Query question"}},
                "required": ["query"]
            },
            "short_memory_size": 10,
            "welcome_message": "Hi, I’m OxyGent. How can I assist you?"
        },
        "tool": {
            "mcp_is_keep_alive": true,
            "concurrent_init": true,
            "semaphore": 1024,
            "timeout": 60
        },
        "live_prompt": {
            "is_active": false,
            "es_polling_interval": 3
        }
    },
    "dev": {},
    "test": {},
    "prod": {}
}